# =============================================================================
# SheSync (PCOS & Hormone Health AI Analyzer) - Environment Variables Template
# Copy this file to .env or .env.local and populate with your credentials
# =============================================================================

# Application Information
VITE_APP_NAME=SheSync
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# -----------------------------------------------------------------------------
# 1. AI Assistant Engine (Google Gemini / OpenAI)
# -----------------------------------------------------------------------------
# Optional: Connect Maya AI to Google Gemini 1.5 for cloud LLM reasoning
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key (if using OpenAI backend)
# VITE_OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# 2. Backend API Endpoint
# -----------------------------------------------------------------------------
# Base URL for custom REST / GraphQL backend server (e.g. Node.js, FastAPI)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# -----------------------------------------------------------------------------
# 3. Database & Authentication (Supabase / Firebase)
# -----------------------------------------------------------------------------
# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Firebase Configuration (Alternative)
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIREBASE_APP_ID=your_app_id

# -----------------------------------------------------------------------------
# 4. Payment Gateway (Razorpay / Stripe)
# -----------------------------------------------------------------------------
# Razorpay Key for PCOS Pro membership checkout
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
VITE_RAZORPAY_CURRENCY=INR

# -----------------------------------------------------------------------------
# 5. Doctor Teleconsultation & Telephony
# -----------------------------------------------------------------------------
# Emergency Hotline fallback numbers
VITE_EMERGENCY_HOTLINE=108
VITE_WOMEN_HELPLINE=1091
